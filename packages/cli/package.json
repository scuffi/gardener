{
  "name": "@scuffi/gardener",
  "version": "0.1.1",
  "description": "Actions-native repository steward: compile .gardener tasks into GitHub Actions workflows and deploy the Gardener runtime to Cloudflare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scuffi/gardener.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "assets",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gardener": "dist/cli.js"
  },
  "dependencies": {
    "wrangler": "4.131.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/cli.ts --bundle --platform=node --format=esm --external:yaml --sourcemap --outfile=dist/cli.js",
    "prepack": "node scripts/prepare-package.mjs --clean && pnpm --filter @gardener/app build && node ../../scripts/check-actions-runtime.mjs && node scripts/prepare-package.mjs && pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@gardener/contracts": "workspace:*",
    "@gardener/core": "workspace:*",
    "@gardener/provider-github": "workspace:*",
    "@gardener/protocol": "workspace:*",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
