{
  "name": "@gardener/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gardener": "dist/cli.js"
  },
  "dependencies": {
    "@gardener/contracts": "workspace:*",
    "@gardener/core": "workspace:*",
    "@gardener/provider-github": "workspace:*",
    "@gardener/protocol": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:yaml --sourcemap --outfile=dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
