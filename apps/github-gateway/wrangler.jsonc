{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gardener-github-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "GATEWAY_ORIGIN": "https://gardener-github-gateway.example.workers.dev",
    "GARDENER_ORIGIN": "https://gardener.example.workers.dev",
    "GARDENER_WORKSPACE_ID": "workspace-local"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gardener-github-gateway",
    "migrations_dir": "migrations"
  }],
  "services": [{
    "binding": "GARDENER",
    "service": "gardener",
    "entrypoint": "GardenerGitHubEntrypoint"
  }]
}
