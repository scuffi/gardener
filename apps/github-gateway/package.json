{
  "name": "@gardener/github-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply gardener-github-gateway --local",
    "db:migrate": "wrangler d1 migrations apply gardener-github-gateway --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@gardener/contracts": "workspace:*",
    "@gardener/core": "workspace:*",
    "@gardener/provider-github": "workspace:*",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.131.1"
  }
}
