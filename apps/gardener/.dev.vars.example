# Copy to .dev.vars for local development. Never commit the real values.
GARDENER_INSTANCE_TOKEN=gdn_local-dev.replace-with-bootstrap-token
CONNECT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional. Set both only when Cloudflare Access protects the Gardener hostname.
# CLOUDFLARE_ACCESS_CLIENT_ID=service-token-client-id.access
# CLOUDFLARE_ACCESS_CLIENT_SECRET=service-token-client-secret
# Local-only dashboard access. Keep false in deployed environments.
LOCAL_DEV_BYPASS=true
