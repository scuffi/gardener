# Copy to .dev.vars for private local development only. Never commit real values.
# Gardener has no GitHub App, OAuth, webhook, or installation credentials.
GARDENER_WORKSPACE_ID=workspace-local

# Local dashboard bypass only. This must remain false in every public deployment.
LOCAL_DEV_BYPASS=true

# Production dashboard identity. The team domain and application AUD are non-secret deployment
# configuration. Store the owner email with `wrangler secret put`, not in a committed file.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=access-application-audience
# CLOUDFLARE_ACCESS_OWNER_EMAIL=owner@example.com
