{
  "name": "@gardener/connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply gardener-connect --local",
    "db:migrate": "wrangler d1 migrations apply gardener-connect --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@gardener/contracts": "workspace:*",
    "@gardener/core": "workspace:*",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
